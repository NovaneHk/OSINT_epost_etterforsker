# OSINT E-post Etterforsker - Production Environment Configuration
# This file contains production environment variables for Docker deployment

# ============================================================================
# SECURITY SETTINGS - CHANGE ALL DEFAULT VALUES IN PRODUCTION!
# ============================================================================

# Database Configuration
POSTGRES_DB=osint_db
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION

# JWT & Security
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_IN_PRODUCTION_MINIMUM_32_CHARACTERS
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_MINIMUM_32_CHARACTERS

# Application Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
BUILD_ENV=production

# API Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Public URLs (update with your domain)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Grafana Admin Password
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_IN_PRODUCTION

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ============================================================================
# EXTERNAL SERVICE CONFIGURATION
# ============================================================================

# Email/SMTP Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=OSINT Team
SMTP_FROM_EMAIL=noreply@yourdomain.com

# External API Keys (optional)
HUNTER_API_KEY=
CLEARBIT_API_KEY=
LINKEDIN_API_KEY=
TWITTER_API_KEY=

# AWS Configuration (optional for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=osint-leads-storage

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
ENABLE_SMTP_VALIDATION=false
ENABLE_REAL_TIME_UPDATES=true
ENABLE_METRICS=true
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
ENABLE_DEBUG=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Security Features
ENABLE_CSP=true
ENABLE_HTTPS_ONLY=true
ENABLE_CSRF_PROTECTION=true

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Connection Pool Settings
CONNECTION_POOL_SIZE=20
MAX_CONCURRENT_REQUESTS=100

# Cache Settings
CACHE_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=50

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,xlsx,json

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# SSL Certificate paths (when using custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# Let's Encrypt Configuration (when using automatic certificates)
LETSENCRYPT_EMAIL=admin@yourdomain.com
LETSENCRYPT_DOMAIN=osint-etterforsker.yourdomain.com

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Backup Storage
BACKUP_STORAGE_TYPE=local  # local, s3, gcs
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_BACKUP_ENCRYPTION_KEY_IN_PRODUCTION

# Database Backup Settings
DB_BACKUP_RETENTION_DAYS=90
DB_BACKUP_COMPRESSION=true

# ============================================================================
# MONITORING ENDPOINTS
# ============================================================================

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# Metrics Collection
METRICS_COLLECTION_INTERVAL=30
METRICS_RETENTION_DAYS=30

# ============================================================================
# DEPLOYMENT INFORMATION
# ============================================================================

# Version Information
APP_VERSION=1.0.0
BUILD_DATE=2025-01-25
DEPLOYMENT_ENV=production

# Contact Information
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit this file with real production values to version control
# 2. Use a secure password manager to generate strong passwords
# 3. Enable proper firewall rules to restrict database access
# 4. Regularly rotate passwords and API keys
# 5. Monitor access logs for suspicious activity
# 6. Use HTTPS in production with valid SSL certificates
# 7. Keep all software dependencies up to date
# 8. Implement proper backup and disaster recovery procedures
#
# ============================================================================