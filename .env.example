# OSINT B2B Email System — Environment Configuration
# Copy this file to .env and fill in actual values before starting.
# For production: set ENVIRONMENT=production and provide real secrets.

# ---------------------------------------------------------------------------
# Core Security (REQUIRED in production)
# ---------------------------------------------------------------------------
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production
ENVIRONMENT=development    # development | staging | production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1   # comma-separated; no wildcard in production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default / development):
DATABASE_URL=sqlite:///./data/osint_cache.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://osint_user:<password>@localhost:5432/osint_db

# ---------------------------------------------------------------------------
# API / CORS
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Redis cache (optional — in-memory fallback used when unset)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT token lifetimes
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Admin / seeding
# ---------------------------------------------------------------------------
SEED_DEFAULT_ADMIN=true          # false in production after first run
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin1234  # CHANGE before production
DEFAULT_ADMIN_FULL_NAME=System Administrator

# ---------------------------------------------------------------------------
# OpenAPI docs in production
# Set ENABLE_ADMIN_DOCS=true and provide a strong ADMIN_DOCS_TOKEN to
# expose /api/docs behind an Authorization: Bearer header guard.
# ---------------------------------------------------------------------------
ENABLE_ADMIN_DOCS=false
ADMIN_DOCS_TOKEN=

# ---------------------------------------------------------------------------
# GDPR / compliance
# ---------------------------------------------------------------------------
GDPR_REQUIRE_CONSENT=false       # true in production
DATA_CONTROLLER_NAME=Your Company Name
DATA_CONTROLLER_EMAIL=privacy@yourcompany.com

# ---------------------------------------------------------------------------
# OSINT External API Keys
# ---------------------------------------------------------------------------
# Have I Been Pwned — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Clearbit enrichment
CLEARBIT_API_KEY=

# Hunter.io email finder
HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# SpiderFoot (requires SpiderFoot running locally)
# ---------------------------------------------------------------------------
SPIDERFOOT_URL=http://localhost:5001
SPIDERFOOT_API_KEY=

# ---------------------------------------------------------------------------
# IntelOwl (requires IntelOwl instance)
# ---------------------------------------------------------------------------
INTELOWL_URL=http://localhost:80
INTELOWL_API_KEY=

# ---------------------------------------------------------------------------
# Recon-ng (optional — falls back to PATH lookup)
# ---------------------------------------------------------------------------
RECONNG_PATH=

# ---------------------------------------------------------------------------
# PwnDB breach check (requires Tor service on port 9050)
# ---------------------------------------------------------------------------
PWNDB_TOR_PROXY=socks5h://127.0.0.1:9050

# ---------------------------------------------------------------------------
# NovaNexus CRM lead import
# ---------------------------------------------------------------------------
NOVANEXUS_API_URL=
NOVANEXUS_API_KEY=
NOVANEXUS_CAMPAIGN_ID=

# ---------------------------------------------------------------------------
# CRM integrations
# ---------------------------------------------------------------------------
# Salesforce
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot
HUBSPOT_ACCESS_TOKEN=

# Microsoft 365
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# n8n workflow automation
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ---------------------------------------------------------------------------
# Email / SMTP (optional)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ENABLE_SMTP_VALIDATION=false

# ---------------------------------------------------------------------------
# Playwright / browser automation
# ---------------------------------------------------------------------------
PLAYWRIGHT_BROWSERS_PATH=./browsers

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=10
DEFAULT_CRAWL_DELAY=1.0

# ---------------------------------------------------------------------------
# WebSocket / real-time
# ---------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30000
WS_METRICS_UPDATE_INTERVAL=5000
WEBSOCKET_MAX_CONNECTIONS=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=

# ---------------------------------------------------------------------------
# Privacy policy (shown in opt-out emails)
# ---------------------------------------------------------------------------
PRIVACY_POLICY_URL=https://yourcompany.com/privacy
OPT_OUT_URL=https://yourcompany.com/opt-out
DATA_RETENTION_DAYS=90

