# OSINT B2B Email System Environment Configuration

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=./browsers

# Proxy Configuration (Optional)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# External API Keys (Optional)
CLEARBIT_API_KEY=
HUNTER_API_KEY=
HUBSPOT_API_KEY=
MAILERLITE_API_KEY=
# Have I Been Pwned — get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Database Configuration
DATABASE_PATH=data/osint_cache.db

# Rate Limiting
DEFAULT_RATE_LIMIT=2.0
MAX_CONCURRENT_REQUESTS=10

# Compliance Settings
PRIVACY_POLICY_URL=https://yourcompany.com/privacy
DATA_CONTROLLER_NAME=Your Company Name
DATA_CONTROLLER_EMAIL=privacy@yourcompany.com
OPT_OUT_URL=https://yourcompany.com/opt-out

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/osint_system.log

# Output Configuration
DEFAULT_OUTPUT_DIR=out
EXPORT_FORMATS=csv,jsonl

# System Configuration
GDPR_COMPLIANCE_MODE=true
AUDIT_LOGGING=true
DATA_RETENTION_DAYS=90

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_METRICS_UPDATE_INTERVAL=5000
WS_STATUS_UPDATE_INTERVAL=10000
WEBSOCKET_MAX_CONNECTIONS=1000
ENABLE_WEBSOCKET_AUTHENTICATION=false
USE_REDIS_PUBSUB=false
REDIS_URL=redis://localhost:6379/0
