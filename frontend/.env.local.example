# Local Development Environment
# Copy this file to .env.local and update with your local values

# Development API (if running backend locally)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Development Database (if needed)
DATABASE_URL=postgresql://postgres:password@localhost:5432/osint_leads_dev
REDIS_URL=redis://localhost:6379

# Development Email (for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM_EMAIL=dev@localhost

# API Keys for Development (use test/sandbox keys)
HUNTER_API_KEY=your-test-hunter-key
CLEARBIT_API_KEY=your-test-clearbit-key

# Development Feature Flags
NEXT_PUBLIC_ENABLE_MSW=true
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_SHOW_DEBUG_INFO=true
NEXT_PUBLIC_MOCK_API=true

# Disable production features in development
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false