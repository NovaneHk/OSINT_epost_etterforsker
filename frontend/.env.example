# Application Configuration
NEXT_PUBLIC_APP_NAME="OSINT Lead Generator"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_DESCRIPTION="Professional B2B lead generation with OSINT techniques"

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000/api/ws
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=3000
NEXT_PUBLIC_WS_MAX_NOTIFICATIONS=10

# Authentication (if implemented)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_AUTH_ENABLED=false

# Database (if direct connection needed)
DATABASE_URL=postgresql://user:password@localhost:5432/osint_leads
REDIS_URL=redis://localhost:6379

# External API Keys
HUNTER_API_KEY=your-hunter-api-key
CLEARBIT_API_KEY=your-clearbit-api-key
LINKEDIN_API_KEY=your-linkedin-api-key
TWITTER_API_KEY=your-twitter-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="OSINT Team"
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Storage Configuration
NEXT_PUBLIC_STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=osint-leads-storage

# Monitoring & Analytics
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# Feature Flags
NEXT_PUBLIC_ENABLE_MSW=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_REQUESTS_PER_MINUTE=60
NEXT_PUBLIC_RATE_LIMIT_BURST=100

# Security
NEXT_PUBLIC_CSP_ENABLED=false
NEXT_PUBLIC_HTTPS_ONLY=false

# Localization
NEXT_PUBLIC_DEFAULT_LANGUAGE=nb
NEXT_PUBLIC_SUPPORTED_LANGUAGES=nb,en

# Development Tools
NEXT_PUBLIC_SHOW_DEBUG_INFO=true
NEXT_PUBLIC_MOCK_API=false
