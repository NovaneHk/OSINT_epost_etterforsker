# Production Environment Configuration Template
# Copy this file to .env and fill in the actual values

# CRITICAL: Never commit actual production secrets to version control
# Use a secure secrets management system in production

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
PRODUCTION_DOMAIN=your-domain.com
LOG_LEVEL=INFO
WORKERS=4

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=osint_b2b
DB_USER=osint_user
DB_PASSWORD=your-secure-database-password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@your-domain.com

# Monitoring Configuration (Optional)
GRAFANA_PASSWORD=your-grafana-password

# Backup Configuration (Optional)
BACKUP_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Alerting Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ADMIN_EMAIL=admin@your-domain.com

# Third-party API Keys (Optional)
CLEARBIT_API_KEY=your-clearbit-api-key
HUNTER_API_KEY=your-hunter-api-key
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Logging Configuration (Optional)
LOG_ENDPOINT=https://your-log-service.com/api/logs
LOG_API_KEY=your-log-service-api-key

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Security Settings
DATA_CONTROLLER=Your Company Name
DPO_EMAIL=dpo@your-domain.com
PRIVACY_POLICY_URL=https://your-domain.com/privacy

# Performance Tuning
MAX_WORKERS=10
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL=3600

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_API_ACCESS=true
ENABLE_BULK_OPERATIONS=true
ENABLE_REAL_TIME_PROCESSING=true

# Development/Testing (Set to false in production)
DEBUG=false
TESTING=false
SIMULATE_SCRAPING=false