# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://osint_user:your-secure-password@localhost:5432/osint_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osint_db
DB_USER=osint_user
DB_PASSWORD=your-secure-password

# API Configuration
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS — comma-separated allowed origins, no trailing slash
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
PRODUCTION_DOMAIN=localhost

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GDPR Compliance
GDPR_REQUIRE_CONSENT=true
GDPR_MASK_UNCONSENTED=true
GDPR_RETENTION_DAYS=365

# Security Settings
SECURITY_PII_ENCRYPT_AT_REST=true
SECURITY_AUDIT_LOG=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_CRAWLERS=10

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# External APIs (Optional)
CLEARBIT_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
# Have I Been Pwned — get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
