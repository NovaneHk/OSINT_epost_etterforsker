# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB)
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=
POSTGRES_DB=osint_db
DATABASE_URL=postgresql://osint_user:<POSTGRES_PASSWORD>@database:5432/osint_db

# API Configuration
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS — set to actual domain in production, never use * or localhost
CORS_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com
PRODUCTION_DOMAIN=yourdomain.com

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GDPR Compliance
GDPR_REQUIRE_CONSENT=true
GDPR_MASK_UNCONSENTED=true
GDPR_RETENTION_DAYS=365

# Security Settings
SECURITY_PII_ENCRYPT_AT_REST=true
SECURITY_AUDIT_LOG=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_CRAWLERS=10

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# External APIs (Optional)
CLEARBIT_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
# Have I Been Pwned — get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
